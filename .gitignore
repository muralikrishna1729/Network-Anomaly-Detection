# Raw dataset -- regenerated via download_data.py, shouldn't be committed
data/

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.env

# Generated outputs -- figures/models/logs are regenerated by running the pipeline,
# not something you want tracked/diffed in git
outputs/figures/*.png
outputs/models/*.joblib
outputs/logs/*.log

# keep the folders themselves tracked even though their contents are ignored
!outputs/figures/.gitkeep
!outputs/models/.gitkeep
!outputs/logs/.gitkeep

# OS/editor noise
.DS_Store
.vscode/
*.swp