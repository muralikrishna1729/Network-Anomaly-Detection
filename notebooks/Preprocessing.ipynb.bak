   ],
   "source": [
    "results_df[\"attack_category\"] = train[\"attack_category\"].iloc[sample_idx].values\n",
    "\n",
    "print(\"Attack category breakdown among NOISE points:\")\n",
    "print(results_df[noise_mask][\"attack_category\"].value_counts())\n",
    "\n",
    "print(\"\\nAttack category breakdown among ALL points in sample (for comparison):\")\n",
    "print(results_df[\"attack_category\"].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "039b53b7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Percentage of each category flagged as noise:\n",
      "attack_category\n",
      "U2R       16.67\n",
      "R2L        3.62\n",
      "Probe      2.29\n",
      "DoS        1.91\n",
      "normal     0.71\n",
      "Name: count, dtype: float64\n"
     ]
    }
   ],
   "source": [
    "noise_counts = results_df[noise_mask][\"attack_category\"].value_counts()\n",
    "total_counts = results_df[\"attack_category\"].value_counts()\n",
    "\n",
    "noise_rate = (noise_counts / total_counts * 100).round(2).sort_values(ascending=False)\n",
    "print(\"Percentage of each category flagged as noise:\")\n",
    "print(noise_rate)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2713c650",
   "metadata": {},
   "source": [
    "- the rarer and more unusual the attack category, the more likely it is to be flagged as noise. U2R (rarest, only 6 samples) has by far the highest noise rate.\n",
    "- DoS and Probe sit in between — not rare enough to always stand out, but not as common as normal either."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 73,
   "id": "585a8893",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.cluster import DBSCAN\n",
    "\n",
    "eps_values = [5, 8, 10, 13, 15]\n",
    "min_samples_values = [5, 10, 15, 20]\n",
    "\n",
    "sweep_results = []"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 74,
   "id": "7966749c",
   "metadata": {},
   "outputs": [],
   "source": [
    "for eps in eps_values:\n",
    "    for min_samp in min_samples_values:\n",
    "        dbscan = DBSCAN(eps=eps, min_samples=min_samp)\n",
    "        labels = dbscan.fit_predict(X_train_sample)\n",
    "        \n",
    "        noise_mask = labels == -1\n",
    "        n_noise = noise_mask.sum()\n",
    "        n_clusters = len(set(labels)) - (1 if -1 in labels else 0)\n",
    "        \n",
    "        if n_noise > 0:\n",
    "            attacks_in_noise = y_train_sample.values[noise_mask].sum()\n",
    "            precision = attacks_in_noise / n_noise\n",
    "            recall = attacks_in_noise / y_train_sample.sum()\n",
    "        else:\n",
    "            precision = 0\n",
    "            recall = 0\n",
    "        \n",
    "        sweep_results.append({\n",
    "            \"eps\": eps,\n",
    "            \"min_samples\": min_samp,\n",
    "            \"n_clusters\": n_clusters,\n",
    "            \"n_noise\": n_noise,\n",
    "            \"noise_pct\": round(n_noise / len(labels) * 100, 2),\n",
    "            \"precision\": round(precision, 3),\n",
    "            \"recall\": round(recall, 3),\n",
    "        })"
   ]
  },
